{
  "shared": {
    "owner": "session server",
    "includes": [
      "admitted input",
      "ordered events",
      "outcomes",
      "snapshots",
      "replay suffixes",
      "controls",
      "queue items",
      "permission requests"
    ]
  },
  "client_local": {
    "owner": "client renderer or transport",
    "cannot_enter_shared_state": [
      "draft",
      "cursor",
      "viewport",
      "terminal_size",
      "ansi",
      "dom",
      "navigation",
      "key_chord",
      "palette",
      "selection_anchor"
    ],
    "interaction_types": ["draft_changed", "cursor_moved", "viewport_changed", "key_local"]
  }
}
