{
  "protocol": "jido.session",
  "version": "1",
  "title": "Jido Console canonical session protocol",
  "json_compatible": true,
  "compatibility": {
    "rule": "additive",
    "compatible_versions": ["1"],
    "unknown_declared_fields": "retain_bounded",
    "unknown_types": "reject",
    "unknown_authority_fields": "reject",
    "breaking_change": "new_major_version"
  },
  "bounds": {
    "max_identity_bytes": 256,
    "max_string_bytes": 65536,
    "max_text_bytes": 200000,
    "max_list_items": 1000,
    "max_map_keys": 128,
    "max_unknown_bytes": 4096,
    "max_unknown_keys": 16,
    "max_snapshot_bytes": 1048576,
    "max_attachments": 20
  },
  "authority": {
    "never_grant_from": ["renderer", "transport", "host", "origin", "unknown"],
    "descriptive_only": ["origin", "host", "transport", "renderer"],
    "authority_fields": ["permission", "approval", "capability", "principal", "scope"]
  },
  "locality": {
    "shared": "Admitted session data owned by the session server.",
    "client_local": "Renderer or transport state that must not enter shared session state."
  },
  "client_local_fields": [
    "draft",
    "cursor",
    "viewport",
    "terminal_size",
    "ansi",
    "dom",
    "navigation",
    "key_chord",
    "palette",
    "selection_anchor"
  ],
  "envelope": {
    "version": "1",
    "compatibility": "additive",
    "required": ["protocol", "version", "family", "type", "id"],
    "fields": {
      "protocol": "protocol_name",
      "version": "version",
      "family": "family_name",
      "type": "type_name",
      "id": "identity",
      "session_id": "identity",
      "created_at": "timestamp",
      "unknown": "unknown_object"
    }
  },
  "identities": {
    "version": "1",
    "compatibility": "additive",
    "kinds": [
      "session",
      "action",
      "turn",
      "lane",
      "step",
      "request",
      "run",
      "worker",
      "approval",
      "control",
      "client",
      "attachment",
      "input",
      "command",
      "invocation"
    ]
  },
  "classifications": {
    "version": "1",
    "compatibility": "additive",
    "durability": ["ephemeral", "process"],
    "sensitivity": ["public", "redacted", "secret"],
    "origin_kinds": ["client", "session", "worker", "jidoka", "system"],
    "trust_fields": ["evidence", "policy"]
  },
  "families": {
    "command": {
      "version": "1",
      "compatibility": "additive",
      "description": "Client requests that the session owner can admit.",
      "types": {
        "submit_input": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "text", "attachments"]
        },
        "steer": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "run_id", "text"]
        },
        "queue_follow_up": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "text"]
        },
        "remove_queued": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "queue"]
        },
        "consume_queued": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "queue"]
        },
        "invoke_command": {
          "locality": "shared",
          "fields": ["command_id", "client_id", "name", "arguments"]
        },
        "acknowledge": {
          "locality": "shared",
          "fields": ["client_id", "sequence"]
        },
        "request_snapshot": {
          "locality": "shared",
          "fields": ["client_id"]
        },
        "request_replay": {
          "locality": "shared",
          "fields": ["client_id", "after_sequence"]
        }
      }
    },
    "event": {
      "version": "1",
      "compatibility": "additive",
      "description": "Ordered semantic session events allocated by the session owner.",
      "required": ["sequence", "durability", "sensitivity", "origin", "trust", "identities"],
      "types": {
        "input_admitted": {"locality": "shared", "fields": ["input_id", "client_id"]},
        "input_started": {"locality": "shared", "fields": ["input_id", "run_id"]},
        "input_completed": {"locality": "shared", "fields": ["input_id", "run_id"]},
        "input_rejected": {"locality": "shared", "fields": ["input_id", "reason"]},
        "input_cancelled": {"locality": "shared", "fields": ["input_id", "reason"]},
        "run_started": {"locality": "shared", "fields": ["run_id", "turn_id"]},
        "run_progress": {"locality": "shared", "fields": ["run_id", "summary"]},
        "run_completed": {"locality": "shared", "fields": ["run_id", "outcome_id", "content"]},
        "run_failed": {"locality": "shared", "fields": ["run_id", "reason"]},
        "worker_started": {"locality": "shared", "fields": ["worker_id", "run_id", "request_id"]},
        "worker_completed": {"locality": "shared", "fields": ["worker_id", "run_id", "request_id"]},
        "worker_failed": {"locality": "shared", "fields": ["worker_id", "run_id", "reason"]},
        "model_delta": {"locality": "shared", "fields": ["run_id", "text"]},
        "model_completed": {"locality": "shared", "fields": ["run_id", "content"]},
        "tool_started": {"locality": "shared", "fields": ["run_id", "step_id", "operation"]},
        "tool_completed": {"locality": "shared", "fields": ["run_id", "step_id", "content"]},
        "tool_failed": {"locality": "shared", "fields": ["run_id", "step_id", "reason"]},
        "permission_requested": {"locality": "shared", "fields": ["approval_id", "principal", "scope"]},
        "permission_decided": {"locality": "shared", "fields": ["approval_id", "decision"]},
        "command_effected": {"locality": "shared", "fields": ["command_id", "effect"]},
        "queue_changed": {"locality": "shared", "fields": ["queue", "items"]},
        "client_attached": {"locality": "shared", "fields": ["client_id", "attachment_id"]},
        "client_detached": {"locality": "shared", "fields": ["client_id", "attachment_id"]},
        "delivery_gap": {"locality": "shared", "fields": ["client_id", "last_acknowledged", "current_sequence"]},
        "control_requested": {"locality": "shared", "fields": ["control_id", "control"]},
        "control_completed": {"locality": "shared", "fields": ["control_id", "result"]},
        "session_failed": {"locality": "shared", "fields": ["reason"]}
      }
    },
    "interaction": {
      "version": "1",
      "compatibility": "additive",
      "description": "Transport-neutral client interactions. Client-local kinds never enter shared state.",
      "types": {
        "user_text": {"locality": "shared", "fields": ["client_id", "text"]},
        "user_steer": {"locality": "shared", "fields": ["client_id", "run_id", "text"]},
        "slash_command": {"locality": "shared", "fields": ["client_id", "name", "arguments"]},
        "permission_response": {"locality": "shared", "fields": ["client_id", "approval_id", "decision"]},
        "client_ack": {"locality": "shared", "fields": ["client_id", "sequence"]},
        "draft_changed": {"locality": "client_local", "fields": ["draft"]},
        "cursor_moved": {"locality": "client_local", "fields": ["cursor"]},
        "viewport_changed": {"locality": "client_local", "fields": ["viewport"]},
        "key_local": {"locality": "client_local", "fields": ["key_chord"]}
      }
    },
    "response": {
      "version": "1",
      "compatibility": "additive",
      "description": "Immediate admission responses for commands, interactions, and controls.",
      "types": {
        "accepted": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "rejected": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "deferred": {"locality": "shared", "fields": ["ref_id", "reason"]}
      }
    },
    "outcome": {
      "version": "1",
      "compatibility": "additive",
      "description": "Terminal semantic results independent of renderer presentation.",
      "types": {
        "completed": {"locality": "shared", "fields": ["ref_id", "content", "view"]},
        "failed": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "cancelled": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "expired": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "no_effect": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "approved": {"locality": "shared", "fields": ["approval_id", "scope"]},
        "denied": {"locality": "shared", "fields": ["approval_id", "scope"]}
      }
    },
    "snapshot": {
      "version": "1",
      "compatibility": "additive",
      "description": "Bounded semantic session snapshots for attach and gap recovery.",
      "types": {
        "session_snapshot": {
          "locality": "shared",
          "fields": ["sequence", "state", "protocol_version"]
        }
      }
    },
    "replay": {
      "version": "1",
      "compatibility": "additive",
      "description": "Replay of an available event suffix after a snapshot.",
      "types": {
        "replay_request": {
          "locality": "shared",
          "fields": ["client_id", "after_sequence"]
        },
        "event_suffix": {
          "locality": "shared",
          "fields": ["after_sequence", "events"]
        }
      }
    },
    "control": {
      "version": "1",
      "compatibility": "additive",
      "description": "Attach, detach, cancel, force kill, recover, and drain controls.",
      "types": {
        "attach": {
          "locality": "shared",
          "fields": ["client_id", "attachment_id", "capabilities"]
        },
        "detach": {
          "locality": "shared",
          "fields": ["client_id", "attachment_id"]
        },
        "cancel": {
          "locality": "shared",
          "fields": ["control_id", "run_id", "request_id", "worker_id"]
        },
        "force_kill": {
          "locality": "shared",
          "fields": ["control_id", "run_id", "request_id", "worker_id"]
        },
        "recover": {
          "locality": "shared",
          "fields": ["client_id", "last_acknowledged"]
        },
        "drain": {
          "locality": "shared",
          "fields": ["control_id", "run_id"]
        }
      }
    }
  }
}
