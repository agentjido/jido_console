{
  "protocol": "jido.session",
  "version": "1",
  "title": "Jido Console canonical session protocol",
  "json_compatible": true,
  "compatibility": {
    "rule": "additive",
    "compatible_versions": ["1"],
    "unknown_declared_fields": "retain_bounded",
    "unknown_types": "reject",
    "unknown_authority_fields": "reject",
    "breaking_change": "new_major_version"
  },
  "bounds": {
    "max_identity_bytes": 256,
    "max_string_bytes": 65536,
    "max_text_bytes": 200000,
    "max_list_items": 1000,
    "max_map_keys": 128,
    "max_unknown_bytes": 4096,
    "max_unknown_keys": 16,
    "max_snapshot_bytes": 1048576,
    "max_attachments": 20
  },
  "authority": {
    "never_grant_from": ["renderer", "transport", "host", "origin", "unknown"],
    "descriptive_only": ["origin", "host", "transport", "renderer"],
    "authority_fields": ["permission", "approval", "capability", "principal", "scope"]
  },
  "locality": {
    "shared": "Admitted session data owned by the session server.",
    "client_local": "Renderer or transport state that must not enter shared session state."
  },
  "client_local_fields": [
    "draft",
    "cursor",
    "viewport",
    "terminal_size",
    "ansi",
    "dom",
    "navigation",
    "key_chord",
    "palette",
    "selection_anchor"
  ],
  "envelope": {
    "version": "1",
    "compatibility": "additive",
    "required": ["protocol", "version", "family", "type", "id"],
    "fields": {
      "protocol": "protocol_name",
      "version": "version",
      "family": "family_name",
      "type": "type_name",
      "id": "identity",
      "session_id": "identity",
      "created_at": "timestamp",
      "unknown": "unknown_object"
    }
  },
  "identities": {
    "version": "1",
    "compatibility": "additive",
    "kinds": [
      "session",
      "action",
      "turn",
      "lane",
      "step",
      "request",
      "run",
      "worker",
      "approval",
      "control",
      "client",
      "attachment",
      "input",
      "command",
      "invocation",
      "operation",
      "result",
      "receipt",
      "generation",
      "owner_instance",
      "watermark",
      "snapshot"
    ]
  },
  "classifications": {
    "version": "1",
    "compatibility": "additive",
    "durability": ["ephemeral", "process", "durable"],
    "sensitivity": ["public", "redacted", "secret"],
    "origin_kinds": ["client", "session", "worker", "jidoka", "system"],
    "trust_fields": ["evidence", "policy"]
  },
  "sensitive_values": {
    "version": "1",
    "allowed_reference_fields": [
      "credential_profile_id",
      "credential_reference_id",
      "credential_source_identity"
    ],
    "forbidden_field_names": [
      "api_key",
      "authorization",
      "cookie",
      "credential",
      "credential_value",
      "password",
      "private_key",
      "secret",
      "secret_value",
      "token"
    ],
    "forbidden_shell_flags": [
      "--api-key",
      "--authorization",
      "--cookie",
      "--credential",
      "--password",
      "--secret",
      "--token"
    ],
    "structural_string_fields": [
      "arguments",
      "effective_arguments",
      "environment",
      "headers",
      "metadata",
      "uri",
      "url"
    ],
    "uri_fields": ["uri", "url"],
    "rejection_types": ["sensitive_value_rejected", "sensitive_result_blocked"],
    "detail_limit_bytes": 2048
  },
  "families": {
    "command": {
      "version": "1",
      "compatibility": "additive",
      "description": "Client requests that the session owner can admit.",
      "types": {
        "submit_input": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "text", "attachments"]
        },
        "steer": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "run_id", "text"]
        },
        "queue_follow_up": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "text"]
        },
        "remove_queued": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "queue"]
        },
        "consume_queued": {
          "locality": "shared",
          "fields": ["input_id", "client_id", "queue"]
        },
        "invoke_command": {
          "locality": "shared",
          "fields": ["command_id", "client_id", "name", "arguments"]
        },
        "acknowledge": {
          "locality": "shared",
          "fields": ["client_id", "sequence"]
        },
        "request_snapshot": {
          "locality": "shared",
          "fields": ["client_id"]
        },
        "request_replay": {
          "locality": "shared",
          "fields": ["client_id", "after_sequence"]
        }
      }
    },
    "delivery": {
      "version": "1",
      "compatibility": "additive",
      "description": "Bounded process-lifetime client delivery values. These values do not enter semantic history or consume a Console sequence.",
      "types": {
        "output_batch": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "batch_id", "first_sequence", "through_sequence", "acknowledgement_token", "events"],
          "fields": ["client_id", "attachment_id", "batch_id", "first_sequence", "through_sequence", "acknowledgement_token", "events"]
        },
        "gap": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "gap_id", "last_acknowledged_sequence", "current_owner_sequence", "reason"],
          "fields": ["client_id", "attachment_id", "gap_id", "last_acknowledged_sequence", "current_owner_sequence", "reason"]
        },
        "attach_snapshot": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "snapshot_sequence", "snapshot"],
          "fields": ["client_id", "attachment_id", "snapshot_sequence", "snapshot"]
        },
        "recovery_snapshot": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "gap_id", "recovery_id", "snapshot_sequence", "recovery_token", "snapshot"],
          "fields": ["client_id", "attachment_id", "gap_id", "recovery_id", "snapshot_sequence", "recovery_token", "snapshot"]
        },
        "recovery_suffix": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "gap_id", "recovery_id", "after_sequence", "through_sequence", "recovery_token", "completion_token", "events"],
          "fields": ["client_id", "attachment_id", "gap_id", "recovery_id", "after_sequence", "through_sequence", "recovery_token", "completion_token", "events"]
        },
        "recovery_receipt": {
          "locality": "shared",
          "required": ["client_id", "attachment_id", "recovery_id", "through_sequence", "process_lifetime"],
          "fields": ["client_id", "attachment_id", "recovery_id", "through_sequence", "process_lifetime"]
        }
      }
    },
    "event": {
      "version": "1",
      "compatibility": "additive",
      "description": "Ordered semantic session events allocated by the session owner.",
      "required": ["sequence", "durability", "sensitivity", "origin", "trust", "identities"],
      "types": {
        "input_admitted": {"locality": "shared", "fields": ["input_id", "client_id"]},
        "input_started": {"locality": "shared", "fields": ["input_id", "run_id"]},
        "input_completed": {"locality": "shared", "fields": ["input_id", "run_id"]},
        "input_rejected": {"locality": "shared", "fields": ["input_id", "reason"]},
        "input_cancelled": {"locality": "shared", "fields": ["input_id", "reason"]},
        "run_started": {"locality": "shared", "fields": ["run_id", "turn_id"]},
        "run_progress": {"locality": "shared", "fields": ["run_id", "summary"]},
        "run_completed": {"locality": "shared", "fields": ["run_id", "outcome_id", "content"]},
        "run_failed": {"locality": "shared", "fields": ["run_id", "reason"]},
        "worker_started": {"locality": "shared", "fields": ["worker_id", "run_id", "request_id"]},
        "worker_completed": {"locality": "shared", "fields": ["worker_id", "run_id", "request_id"]},
        "worker_failed": {"locality": "shared", "fields": ["worker_id", "run_id", "reason"]},
        "model_delta": {"locality": "shared", "fields": ["run_id", "text"]},
        "model_completed": {"locality": "shared", "fields": ["run_id", "content"]},
        "tool_started": {"locality": "shared", "fields": ["run_id", "step_id", "operation"]},
        "tool_completed": {"locality": "shared", "fields": ["run_id", "step_id", "content"]},
        "tool_failed": {"locality": "shared", "fields": ["run_id", "step_id", "reason"]},
        "permission_requested": {"locality": "shared", "fields": ["approval_id", "principal", "scope"]},
        "permission_decided": {"locality": "shared", "fields": ["approval_id", "decision"]},
        "command_effected": {"locality": "shared", "fields": ["command_id", "effect"]},
        "queue_changed": {"locality": "shared", "fields": ["queue", "items"]},
        "client_attached": {"locality": "shared", "fields": ["client_id", "attachment_id"]},
        "client_detached": {"locality": "shared", "fields": ["client_id", "attachment_id"]},
        "delivery_gap": {
          "locality": "shared",
          "fields": ["client_id", "last_acknowledged", "current_sequence"],
          "deprecated": true,
          "emission": "input_only"
        },
        "control_requested": {"locality": "shared", "fields": ["control_id", "control"]},
        "control_completed": {"locality": "shared", "fields": ["control_id", "result"]},
        "session_failed": {"locality": "shared", "fields": ["reason"]}
      }
    },
    "interaction": {
      "version": "1",
      "compatibility": "additive",
      "description": "Transport-neutral client interactions. Client-local kinds never enter shared state.",
      "types": {
        "user_text": {"locality": "shared", "fields": ["client_id", "text"]},
        "user_steer": {"locality": "shared", "fields": ["client_id", "run_id", "text"]},
        "slash_command": {"locality": "shared", "fields": ["client_id", "name", "arguments"]},
        "permission_response": {"locality": "shared", "fields": ["client_id", "approval_id", "decision"]},
        "client_ack": {"locality": "shared", "fields": ["client_id", "sequence"]},
        "draft_changed": {"locality": "client_local", "fields": ["draft"]},
        "cursor_moved": {"locality": "client_local", "fields": ["cursor"]},
        "viewport_changed": {"locality": "client_local", "fields": ["viewport"]},
        "key_local": {"locality": "client_local", "fields": ["key_chord"]}
      }
    },
    "response": {
      "version": "1",
      "compatibility": "additive",
      "description": "Immediate admission responses for commands, interactions, and controls.",
      "types": {
        "accepted": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "rejected": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "deferred": {"locality": "shared", "fields": ["ref_id", "reason"]}
      }
    },
    "outcome": {
      "version": "1",
      "compatibility": "additive",
      "description": "Terminal semantic results independent of renderer presentation.",
      "types": {
        "completed": {"locality": "shared", "fields": ["ref_id", "content", "view"]},
        "failed": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "cancelled": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "expired": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "no_effect": {"locality": "shared", "fields": ["ref_id", "reason"]},
        "approved": {"locality": "shared", "fields": ["approval_id", "scope"]},
        "denied": {"locality": "shared", "fields": ["approval_id", "scope"]}
      }
    },
    "snapshot": {
      "version": "1",
      "compatibility": "additive",
      "description": "Bounded semantic session snapshots for attach and gap recovery.",
      "types": {
        "session_snapshot": {
          "locality": "shared",
          "fields": ["sequence", "state", "protocol_version"]
        }
      }
    },
    "replay": {
      "version": "1",
      "compatibility": "additive",
      "description": "Replay of an available event suffix after a snapshot.",
      "types": {
        "replay_request": {
          "locality": "shared",
          "fields": ["client_id", "after_sequence"]
        },
        "event_suffix": {
          "locality": "shared",
          "fields": ["after_sequence", "events"]
        }
      }
    },
    "control": {
      "version": "1",
      "compatibility": "additive",
      "description": "Attach, detach, cancel, force kill, recover, and drain controls.",
      "types": {
        "attach": {
          "locality": "shared",
          "fields": ["client_id", "attachment_id", "capabilities"]
        },
        "detach": {
          "locality": "shared",
          "fields": ["client_id", "attachment_id"]
        },
        "cancel": {
          "locality": "shared",
          "fields": ["control_id", "run_id", "request_id", "worker_id"]
        },
        "force_kill": {
          "locality": "shared",
          "fields": ["control_id", "run_id", "request_id", "worker_id"]
        },
        "recover": {
          "locality": "shared",
          "fields": ["client_id", "last_acknowledged"]
        },
        "drain": {
          "locality": "shared",
          "fields": ["control_id", "run_id"]
        }
      }
    },
    "receipt": {
      "version": "1",
      "compatibility": "additive",
      "description": "Durable commit receipts and the separate process-lifetime client acknowledgement.",
      "types": {
        "input": {
          "locality": "shared",
          "required": ["operation_id", "idempotency_key", "payload_digest", "sequence", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "idempotency_key", "payload_digest", "sequence", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["sqlite_full_commit"], "status": ["committed", "timeout_unknown"]}
        },
        "command": {
          "locality": "shared",
          "required": ["operation_id", "idempotency_key", "payload_digest", "result_id", "effective_arguments", "sequence", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "idempotency_key", "payload_digest", "result_id", "effective_arguments", "sequence", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["sqlite_full_commit"], "status": ["committed", "timeout_unknown"]}
        },
        "console_event": {
          "locality": "shared",
          "required": ["operation_id", "event_id", "sequence", "chain_digest", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "event_id", "sequence", "chain_digest", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["sqlite_full_commit"], "status": ["committed", "timeout_unknown"]}
        },
        "jidoka_checkpoint": {
          "locality": "shared",
          "required": ["operation_id", "jidoka_session_id", "jidoka_revision", "snapshot_id", "value_digest", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "jidoka_session_id", "jidoka_revision", "snapshot_id", "value_digest", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["jidoka_store_transition"], "status": ["committed", "timeout_unknown"]}
        },
        "effect_start": {
          "locality": "shared",
          "required": ["operation_id", "result_id", "arguments_digest", "safety_class", "replay_rule", "approval_id", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "result_id", "arguments_digest", "safety_class", "replay_rule", "approval_id", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["sqlite_full_commit"], "status": ["committed", "timeout_unknown"]}
        },
        "effect_result": {
          "locality": "shared",
          "required": ["operation_id", "result_id", "jidoka_revision", "result_status", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "result_id", "jidoka_revision", "result_status", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["durable"], "commit_boundary": ["jidoka_store_transition"], "status": ["committed", "timeout_unknown"]}
        },
        "watermark": {
          "locality": "shared",
          "required": ["operation_id", "watermark_id", "watermark_state", "durability", "commit_boundary", "status"],
          "fields": ["operation_id", "watermark_id", "watermark_state", "durability", "commit_boundary", "status"],
          "field_values": {"watermark_state": ["verified"], "durability": ["durable"], "commit_boundary": ["verified_watermark_commit"], "status": ["committed", "timeout_unknown"]}
        },
        "client_output": {
          "locality": "client_local",
          "required": ["attachment_id", "through_sequence", "durability", "commit_boundary", "status"],
          "fields": ["attachment_id", "through_sequence", "durability", "commit_boundary", "status"],
          "field_values": {"durability": ["process"], "commit_boundary": ["live_attachment_apply"], "status": ["applied"]}
        }
      }
    },
    "generation": {
      "version": "1",
      "compatibility": "additive",
      "description": "Durable owner-generation claims and stale-operation results.",
      "types": {
        "claim": {
          "locality": "shared",
          "required": ["generation", "owner_instance_id", "prior_generation", "operation_id", "status"],
          "fields": ["generation", "owner_instance_id", "prior_generation", "operation_id", "status"],
          "field_values": {"status": ["claimed", "conflict", "timeout_unknown"]}
        },
        "fenced_operation": {
          "locality": "shared",
          "required": ["generation", "owner_instance_id", "operation_id", "status"],
          "fields": ["generation", "owner_instance_id", "operation_id", "status"],
          "field_values": {"status": ["accepted", "stale_generation", "wrong_owner"]}
        }
      }
    },
    "watermark": {
      "version": "1",
      "compatibility": "additive",
      "description": "One verified Console-to-Jidoka durable boundary.",
      "types": {
        "console_jidoka": {
          "locality": "shared",
          "required": ["watermark_id", "generation", "console_sequence", "console_event_id", "console_chain_digest", "jidoka_session_id", "jidoka_revision", "jidoka_snapshot_id", "jidoka_value_digest", "jidoka_request_id", "jidoka_lease_id", "protocol_version", "durable_schema_version", "state"],
          "fields": ["watermark_id", "generation", "console_sequence", "console_event_id", "console_chain_digest", "jidoka_session_id", "jidoka_revision", "jidoka_snapshot_id", "jidoka_value_digest", "jidoka_request_id", "jidoka_lease_id", "protocol_version", "durable_schema_version", "state"],
          "field_values": {"state": ["reserved", "jidoka_committed", "console_committed", "verified", "repair_required", "abandoned"]}
        }
      }
    },
    "recovery": {
      "version": "1",
      "compatibility": "additive",
      "description": "Store and session recovery states that do not grant execution authority.",
      "types": {
        "store_state": {
          "locality": "shared",
          "required": ["state", "schema_version", "diagnostics"],
          "fields": ["state", "schema_version", "diagnostics"],
          "field_values": {"state": ["validating_home", "recovering_maintenance", "migrating_store", "verifying_store", "store_ready", "unavailable"]}
        },
        "session_state": {
          "locality": "shared",
          "required": ["generation", "state", "diagnostics"],
          "fields": ["generation", "state", "diagnostics"],
          "field_values": {"state": ["loading", "claiming_generation", "verifying_history", "reconciling", "rebuilding", "exact_candidate", "transcript_candidate", "repair_required", "unavailable", "ready_exact", "ready_transcript_only"]}
        },
        "continuity_mode": {
          "locality": "shared",
          "required": ["mode", "ready", "execution_authority", "watermark_id"],
          "fields": ["mode", "ready", "execution_authority", "watermark_id"],
          "field_values": {"mode": ["exact", "transcript_only"], "ready": [true, false], "execution_authority": ["none", "explicit_continuation_only", "read_only"]}
        }
      }
    },
    "operation": {
      "version": "1",
      "compatibility": "additive",
      "description": "Separate typed results for continuity and administrative operations.",
      "types": {
        "exact_resume": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "watermark_id", "generation"],
          "field_values": {"status": ["ready_exact", "rejected"], "mode": ["exact"], "calls_model_or_tool": [false], "watermark_required": ["yes"]}
        },
        "transcript_only_resume": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "last_verified_watermark_id"],
          "field_values": {"status": ["ready_transcript_only", "rejected"], "mode": ["transcript_only"], "calls_model_or_tool": [false], "watermark_required": ["no"]}
        },
        "retry": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "new_request_id", "new_result_id"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "new_request_id", "new_result_id"],
          "field_values": {"status": ["reserved", "rejected", "timeout_unknown"], "mode": ["retry"], "calls_model_or_tool": [true], "watermark_required": ["no"]}
        },
        "repair": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "decision_id"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "decision_id"],
          "field_values": {"status": ["planned", "completed", "rejected", "timeout_unknown"], "mode": ["repair"], "calls_model_or_tool": [false], "watermark_required": ["depends_on_case"]}
        },
        "abandon": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "decision_id"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "decision_id"],
          "field_values": {"status": ["abandoned", "rejected", "timeout_unknown"], "mode": ["abandon"], "calls_model_or_tool": [false], "watermark_required": ["no"]}
        },
        "fork": {
          "locality": "shared",
          "required": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "child_session_id", "parent_boundary"],
          "fields": ["operation_id", "status", "mode", "calls_model_or_tool", "watermark_required", "authority_rule", "child_session_id", "parent_boundary"],
          "field_values": {"status": ["forked", "rejected", "timeout_unknown"], "mode": ["exact_fork", "transcript_only_fork"], "calls_model_or_tool": [false], "watermark_required": ["yes", "no"]}
        }
      }
    },
    "rejection": {
      "version": "1",
      "compatibility": "additive",
      "description": "Bounded redacted results for structural admission and final-call containment.",
      "types": {
        "sensitive_value_rejected": {
          "locality": "shared",
          "required": ["operation_id", "phase", "surface", "reason", "redacted_details"],
          "fields": ["operation_id", "phase", "surface", "reason", "redacted_details"],
          "field_values": {"phase": ["before_persistence"], "surface": ["input", "command", "effect", "metadata", "error", "jidoka_value"]},
          "max_encoded_bytes": 65536
        },
        "sensitive_result_blocked": {
          "locality": "shared",
