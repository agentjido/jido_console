{
  "contract": "jido.continuity",
  "version": "1",
  "title": "Jido Console durable continuity contract",
  "status": "frozen",
  "storage": {
    "engine_class": "sqlite",
    "adapter_status": "qualification_required",
    "remote_service_allowed": false,
    "root": "JIDO_HOME/state/sessions/v1",
    "database": "console.sqlite3",
    "layout": [
      "console.sqlite3",
      "console.sqlite3-wal",
      "console.sqlite3-shm",
      "lock",
      "backups",
      "archives",
      "quarantine",
      "manifests",
      "tmp/sqlite",
      "tmp/app"
    ],
    "directory_mode": "0700",
    "file_mode": "0600",
    "writer_count": 1,
    "database_count": 1,
    "sqlite": {
      "journal_mode": "WAL",
      "synchronous": "FULL",
      "foreign_keys": true,
      "busy_timeout_ms": 250,
      "page_size_bytes": 4096,
      "auto_vacuum": "INCREMENTAL",
      "max_page_count": 262144,
      "temp_store": "MEMORY",
      "writer_cache_kib": 32768,
      "reader_cache_kib": 8192,
      "hard_heap_limit_bytes": 536870912,
      "write_transaction": "BEGIN IMMEDIATE"
    }
  },
  "records": [
    {"name": "store_manifest", "owner": "console_store", "class": "authoritative", "durability": "durable"},
    {"name": "session_manifest", "owner": "console_store", "class": "authoritative", "durability": "durable"},
    {"name": "generation_claim", "owner": "console_store", "class": "authoritative", "durability": "durable"},
    {"name": "canonical_console_event", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "input_receipt", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "command_receipt", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "queue_mutation", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "interaction_permission", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "turn_manifest", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "effect_reservation", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "effect_resolution", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "verified_watermark", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "fork_reservation_lineage", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "administrative_decision", "owner": "console_store", "class": "authoritative", "durability": "durable"},
    {"name": "audit_chain", "owner": "console_session", "class": "authoritative", "durability": "durable"},
    {"name": "credential_profile_reference", "owner": "console_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_session_value", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_conversation_request_state", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_snapshot_checkpoint", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_effect_intent_result", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_pending_review", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_worker_lease_recovery", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_environment_checkpoint", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "jidoka_fork_lineage", "owner": "jidoka_session_store", "class": "authoritative", "durability": "durable"},
    {"name": "semantic_snapshot", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "transcript_outcome_projection", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "queue_permission_index", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "session_catalog_search_index", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "compact_model_context", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "client_history_page_index", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "audit_view_report", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "archive_index", "owner": "console_projection", "class": "derived", "durability": "durable"},
    {"name": "client_attachment", "owner": "session_client", "class": "process_local", "durability": "process"},
    {"name": "client_delivery_queue", "owner": "session_delivery", "class": "process_local", "durability": "process"},
    {"name": "client_delivery_acknowledgement", "owner": "session_delivery", "class": "process_local", "durability": "process"},
    {"name": "worker_task_timer", "owner": "session_runtime", "class": "process_local", "durability": "process"},
    {"name": "writer_call_reservation", "owner": "storage_admission", "class": "process_local", "durability": "process"},
    {"name": "runtime_provider_client", "owner": "runtime_boundary", "class": "process_local", "durability": "process"},
    {"name": "extension_runtime_capability", "owner": "extension_host", "class": "process_local", "durability": "process"},
    {"name": "materialized_credential_value", "owner": "final_call_boundary", "class": "sensitive", "durability": "process"},
    {"name": "redacted_blocked_result", "owner": "final_call_boundary", "class": "sensitive", "durability": "process"},
    {"name": "credential_value", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"},
    {"name": "beam_runtime_value", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"},
    {"name": "renderer_state", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"},
    {"name": "raw_provider_client_payload", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"},
    {"name": "raw_jidoka_history_in_console", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"},
    {"name": "descriptive_authority", "owner": "no_owner", "class": "forbidden", "durability": "forbidden"}
  ],
  "acknowledgements": [
    {"item": "input", "durability": "durable", "durable_operation": "sqlite_full_commit", "required_records": ["input_receipt", "payload_digest", "admission_event", "sequence"], "before": "execution_wakeup"},
    {"item": "mutating_command", "durability": "durable", "durable_operation": "sqlite_full_commit", "required_records": ["command_receipt", "effective_arguments", "result_identity", "semantic_event"], "before": "effect_dispatch"},
    {"item": "console_event", "durability": "durable", "durable_operation": "sqlite_full_commit", "required_records": ["canonical_json", "event_identity", "sequence", "chain_digest"], "before": "receipt_return"},
    {"item": "jidoka_checkpoint", "durability": "durable", "durable_operation": "jidoka_store_transition", "required_records": ["jidoka_revision", "snapshot_identity"], "before": "checkpoint_receipt_return"},
    {"item": "effect_start", "durability": "durable", "durable_operation": "sqlite_full_commit", "required_records": ["result_identity", "effective_arguments", "safety_class", "replay_rule", "required_approval"], "before": "external_dispatch"},
    {"item": "effect_result", "durability": "durable", "durable_operation": "jidoka_store_transition", "required_records": ["jidoka_result", "jidoka_revision"], "before": "console_completion"},
    {"item": "watermark", "durability": "durable", "durable_operation": "verified_watermark_commit", "required_records": ["matching_console_identity_digest", "matching_jidoka_identity_digest"], "before": "exact_resume_claim"},
    {"item": "client_output", "durability": "process", "durable_operation": "live_attachment_apply", "required_records": ["attachment_identity", "through_sequence"], "before": "process_acknowledgement"}
  ],
  "generation_fence": {
    "required_identity": ["session_id", "generation", "owner_instance_id", "operation_id"],
    "claim": "atomic_larger_generation",
    "complements": "jidoka_lease",
    "fenced_operations": [
      "worker_result",
      "runtime_event",
      "timer",
      "cancellation",
      "permission_expiry",
      "storage_command",
      "storage_reply",
      "checkpoint_callback",
      "watermark_commit",
      "recovery_completion",
      "client_operation",
      "client_acknowledgement",
      "fork_completion"
    ],
    "stale_result": "reject_before_storage_mutation"
  },
  "watermark": {
    "required_fields": [
      "console_session_id",
      "console_generation",
      "console_sequence",
      "console_event_id",
      "console_chain_digest",
      "jidoka_session_id",
      "jidoka_session_revision",
      "jidoka_snapshot_id",
      "jidoka_value_digest",
      "jidoka_request_id",
      "jidoka_lease_id",
      "console_protocol_version",
      "durable_schema_version"
    ],
    "states": ["reserved", "jidoka_committed", "console_committed", "verified", "repair_required", "abandoned"],
    "transitions": [
      ["reserved", "jidoka_committed"],
      ["jidoka_committed", "console_committed"],
      ["console_committed", "verified"],
      ["console_committed", "repair_required"],
      ["console_committed", "abandoned"],
      ["repair_required", "abandoned"]
    ],
    "verified_commit_order": "last",
    "exact_resume_state": "verified"
  },
  "recovery_lifecycle": {
    "store": ["validating_home", "recovering_maintenance", "migrating_store", "verifying_store", "store_ready"],
    "session": ["loading", "claiming_generation", "verifying_history", "reconciling", "rebuilding"],
    "candidates": ["exact_candidate", "transcript_candidate", "repair_required", "unavailable"],
    "ready": ["ready_exact", "ready_transcript_only"],
    "candidate_authority": "none"
  },
  "operations": [
    {"name": "pure_replay", "calls_model_or_tool": false, "watermark_required": "no", "authority_rule": "data_projection_only"},
    {"name": "recovery_load", "calls_model_or_tool": false, "watermark_required": "no", "authority_rule": "no_execution_authority"},
    {"name": "exact_resume", "calls_model_or_tool": false, "watermark_required": "yes", "authority_rule": "new_generation_and_valid_jidoka_lease"},
    {"name": "exact_continuation", "calls_model_or_tool": true, "watermark_required": "yes", "authority_rule": "explicit_request_after_ready_exact"},
    {"name": "transcript_only_resume", "calls_model_or_tool": false, "watermark_required": "no", "authority_rule": "read_only_visibly_degraded"},
    {"name": "retry", "calls_model_or_tool": true, "watermark_required": "no", "authority_rule": "new_request_result_receipt_and_safety_decision"},
    {"name": "fork", "calls_model_or_tool": false, "watermark_required": "depends_on_mode", "authority_rule": "new_session_no_live_authority_transfer"},
    {"name": "repair", "calls_model_or_tool": false, "watermark_required": "depends_on_fault", "authority_rule": "verified_staged_replacement_or_supported_decision"},
    {"name": "session_reconciliation", "calls_model_or_tool": false, "watermark_required": "depends_on_case", "authority_rule": "explicit_supported_decision_only"},
    {"name": "abandon", "calls_model_or_tool": false, "watermark_required": "no", "authority_rule": "blocks_later_automatic_execution"},
    {"name": "client_attach", "calls_model_or_tool": false, "watermark_required": "depends_on_mode", "authority_rule": "new_attachment_in_current_generation"},
    {"name": "transcript_only_fork", "calls_model_or_tool": false, "watermark_required": "no", "authority_rule": "new_read_only_console_session"}
  ],
  "limits": {
    "protocol_max_text_bytes": 200000,
    "protocol_max_list_items": 1000,
    "protocol_max_map_keys": 128,
    "protocol_max_unknown_bytes": 4096,
    "protocol_max_unknown_keys": 16,
    "sqlite_page_size_bytes": 4096,
    "active_database_pages": 262144,
    "active_database_bytes": 1073741824,
    "normal_database_admission_pages": 221184,
    "normal_database_admission_bytes": 905969664,
    "reserved_database_control_pages": 40960,
    "reserved_database_control_bytes": 167772160,
    "state_tree_bytes": 4294967296,
    "normal_state_tree_admission_bytes": 3758096384,
    "maintenance_reserve_bytes": 536870912,
    "active_database_budget_bytes": 1073741824,
    "wal_budget_bytes": 402653184,
    "control_file_budget_bytes": 16777216,
    "verified_backup_budget_bytes": 1073741824,
    "verified_archive_budget_bytes": 536870912,
    "shared_maintenance_budget_bytes": 1073741824,
    "unallocated_structural_safety_bytes": 117440512,
    "active_sessions": 128,
    "session_console_records_bytes": 67108864,
    "session_jidoka_value_bytes": 134217728,
    "session_canonical_events": 10000,
    "encoded_console_record_bytes": 262144,
    "semantic_snapshot_bytes": 1048576,
    "startup_suffix_events": 1000,
    "startup_suffix_bytes": 8388608,
    "snapshot_interval_events": 500,
    "snapshot_interval_suffix_bytes": 8388608,
    "retained_verified_snapshots": 3,
    "writer_operations": 128,
