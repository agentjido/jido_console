  "crash_points": [
    {"id": "before_writer_admission", "result": "no_write_no_acknowledgement"},
    {"id": "admitted_before_writer_receive", "result": "bounded_queue_retry_by_operation_id"},
    {"id": "transaction_before_commit", "result": "full_rollback"},
    {"id": "commit_before_writer_reply", "result": "same_receipt"},
    {"id": "writer_reply_before_caller_receive", "result": "same_receipt_no_duplicate"},
    {"id": "input_commit_before_wakeup", "result": "recovery_wakes_once"},
    {"id": "effect_reservation_before_dispatch", "result": "explicit_safe_retry_rule"},
    {"id": "unsafe_dispatch_before_result", "result": "uncertain_never_repeat_automatically"},
    {"id": "jidoka_checkpoint_before_console_projection", "result": "deterministic_projection_or_repair_required"},
    {"id": "console_projection_before_jidoka_checkpoint", "result": "no_false_exact_resume"},
    {"id": "both_sides_before_watermark", "result": "verify_and_commit_once"},
    {"id": "generation_claim_before_owner_start", "result": "reuse_or_advance_safely"},
    {"id": "session_runtime_process_death", "result": "durable_recovery_and_stale_fence"},
    {"id": "writer_death", "result": "no_false_acknowledgement_stop_mutation"},
    {"id": "application_or_os_kill", "result": "all_acknowledged_state_returns"},
    {"id": "wal_checkpoint", "result": "committed_transaction_remains_valid"},
    {"id": "persistent_reader", "result": "interrupt_reader_and_bound_wal"},
    {"id": "checkpoint_stays_busy", "result": "stop_page_writes_preserve_wal"},
    {"id": "maintenance_staging", "result": "one_verified_copy_no_partial_authority"},
    {"id": "sqlite_temporary_work", "result": "no_file_outside_state_root"},
    {"id": "disk_full_or_permission_failure", "result": "typed_failure_before_acknowledgement"},
    {"id": "corrupt_or_future_schema", "result": "typed_unavailable_no_empty_store"},
    {"id": "stale_generation_input", "result": "reject_before_mutation"}
  ],
  "qualification_profile": {
    "platform": "darwin-arm64",
    "durable_acknowledgement_p95_ms": 250,
    "durable_acknowledgement_max_ms": 1000,
    "exact_recovery_ready_p95_ms": 10000,
    "exact_recovery_ready_max_ms": 15000,
    "post_ready_attach_p95_ms": 1000,
    "migration_ready_p95_ms": 30000,
    "warm_runs": 20,
    "os_kill_repetitions_per_window": 25
  }
