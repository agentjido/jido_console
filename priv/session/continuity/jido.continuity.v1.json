    "small_writer_request_bytes": 2097152,
    "large_jidoka_request_bytes": 142606336,
    "large_writer_normal_lanes": 1,
    "large_writer_control_lanes": 1,
    "admitted_logical_payload_bytes": 301989888,
    "transactions_in_flight": 1,
    "wal_checkpoint_target_bytes": 33554432,
